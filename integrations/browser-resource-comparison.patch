+/** Original Browser LLM Bench report/profile contract for the bounded local comparison. */
+import { makeProfile, recordPoint, setSignal, startMainProfiler, clockMs } from "../metrics/browser-profiler";
+import { planFor } from "../protocol/schedule";
+import { PROFILE_PROTOCOL, reportSchema, type Report } from "../schemas/report";
+import type { Phase } from "../schemas/profile";
+import { runnableModels, type RunnableModel } from "../runtime/catalog";
+import type { TaskEvaluation } from "../task-evaluation/protocol";
+
+export function resourceReport(config: TaskEvaluation) {
+  if (!config.resourceComparison || !config.sourceRevision || !config.resourceArtifact) throw Error("Resource identity required");
+  const model = config.model;
+  const metadata = config.resourceArtifact;
+  // Registration is scoped to this fresh page. No catalog-wide queue is exposed.
+  if (runnableModels.some(m => m.id === model.id)) throw Error("Study model already registered");
+  const pin: RunnableModel = {
+    ...model, name: model.id, slug: model.id, parameters: metadata.nominalParameters,
+    family: "Qwen3.5", card: "https://huggingface.co/Qwen/Qwen3.5-0.8B",
+    runtime: "WebLLM 0.2.86", revision: config.sourceRevision,
+    thinkingDisabled: true, weightShardBytes: metadata.weightShardBytes, estimatedVramMB: null,
+    contextWindow: 4096, validationStatus: "package-verified",
+    artifact: { manifestUrl: model.modelUrl + "tensor-cache.json",
+      manifestSha256: config.assets.find(a => a.url === model.modelUrl + "tensor-cache.json")!.sha256,
+      weightShardBytes: metadata.weightShardBytes, shards: metadata.shards,
+      nominalParameters: metadata.nominalParameters, theoreticalFP16Bytes: metadata.nominalParameters * 2 },
+  };
+  runnableModels.push(pin);
+  const profile = makeProfile(planFor("repeat", "session-count", config.settings), true);
+  // Package metadata is frozen from the same on-disk artifact manifest.
+  profile.artifact = pin.artifact;
+  const report: Report = {
+    schema: "browser-inference-bench-report-v2", id: crypto.randomUUID(),
+    createdAt: new Date().toISOString(), source: "local", protocol: PROFILE_PROTOCOL,
+    model: model.id, revision: config.sourceRevision, modelUrl: model.modelUrl,
+    modelLib: model.modelLib, quantization: model.quantization, runtime: "WebLLM 0.2.86",
+    executionBackend: "webgpu", resourcePolicy: "browser-managed; no dedicated resource reservation",
+    workload: "repeat", status: "failed",
+    environment: { userAgent: navigator.userAgent, platform: navigator.platform,
+      deviceLabel: "Matched local Qwen comparison", hardwareConcurrency: navigator.hardwareConcurrency || 0,
+      webgpu: Boolean((navigator as any).gpu), adapter: null },
+    settings: { thinkingMode: "disabled", temperature: 0, topP: 1, seed: 42,
+      maxTokens: 64, contextWindow: 4096, warmups: 1, warmupTokens: 16, repeats: 60 },
+    cache: "Fresh dedicated browser profile; empty IndexedDB weight cache; verified local assets; no-store fetch",
+    loadMs: null, firstPreparationMs: null, downloadBytes: null, downloadMs: null,
+    memory: { jsHeapBytes: null, gpuBytes: null,
+      note: "Main-page JS heap only. GPUBuffer descriptors are allocation accounting, not physical VRAM. WASM address space and native process footprint remain separately scoped." },
+    responsiveness: { maxEventLoopDelayMs: 0, samples: 0 }, samples: [], profile,
+    diagnostics: ["Original standard comparison: 60 requests, three windows of 20, two full 90-second loaded-idle gaps, resetChat each request. One warmup excluded. Original 60-second request and 30-minute session safety limits retained; a stricter shared study deadline can stop early.",
+      "Power unavailable unless separately captured; host-wide energy is not model-only energy. Missing signals are null. Two sessions per artifact are a small pilot; requests within a session are not independent experiments."],
+  };
+  let phase: Phase = "baseline";
+  const stop = startMainProfiler(profile, () => phase, () => {});
+  return {
+    report,
+    observe(type: string, data: any) {
+      if (type === "phase") phase = data;
+      if (type === "event" && profile.events.length < 6000) profile.events.push(data);
+      if (type === "point") recordPoint(profile, data);
+      if (type === "signal") setSignal(profile, data);
+      if (type === "network") profile.network = data;
+      if (type === "active-start") profile.activeStartedMs = data;
+      if (type === "active-end") profile.activeEndedMs = data;
+      if (type === "count") profile.completedRequests = data;
+      if (type === "loaded") report.loadMs = data;
+      if (type === "sample") { report.samples.push(data); if (data.warmup) report.firstPreparationMs = data.responseMs; }
+      if (type === "diagnostic" && report.diagnostics.length < 100) report.diagnostics.push(data);
+    },
+    finish(done: any, forced: boolean) {
+      stop();
+      Object.assign(profile, { stopReason: done.reason, activeStartedMs: done.activeStartedMs ?? profile.activeStartedMs,
+        activeEndedMs: done.activeEndedMs ?? profile.activeEndedMs, completedRequests: done.completedRequests ?? profile.completedRequests,
+        unloadConfirmed: !forced && Boolean(done.unloadConfirmed), totalMs: clockMs() - profile.startedEpochMs });
+      report.status = done.status === "complete" && report.samples.every(s => s.valid) ? "complete" : done.status === "complete" ? "failed" : done.status;
+      report.memory.jsHeapBytes = (performance as any).memory?.usedJSHeapSize ?? null;
+      const lags = profile.points.filter(p => p.scope === "main" && p.eventLoopDelayMs !== null);
+      report.responsiveness = { samples: lags.length, maxEventLoopDelayMs: Math.max(0, ...lags.map(p => p.eventLoopDelayMs!)) };
+      profile.events.sort((a,b) => a.tMs - b.tMs);
+      return reportSchema.parse(report);
+    },
+  };
+}
