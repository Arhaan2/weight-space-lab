+/** Build the new study's frozen browser configuration; no engine or generation. */
+import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { createHash } from 'node:crypto';
+const [sourceConfigPath, developmentPath, tokenAuditPath, outputPath] = process.argv.slice(2);
+if (!outputPath) throw Error('Usage: prepare-ifeval-config.mjs V2_BASELINE_CONFIG DEVELOPMENT_ITEMS TOKEN_AUDIT NEW_OUTPUT');
+const parse = p => JSON.parse(readFileSync(p));
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const sorted = value => Array.isArray(value) ? value.map(sorted) : value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort().map(key => [key, sorted(value[key])])) : value;
+const config = parse(sourceConfigPath), items = parse(developmentPath), audit = parse(tokenAuditPath);
+if (config.arm !== 'baseline' || config.model.quantization !== 'q4f16_1' || items.length !== 32 ||
+    new Set(items.map(item => item.item_id)).size !== 32 ||
+    items.some(item => item.benchmark !== 'ifeval' || item.split !== 'development' || !item.task_text))
+  throw Error('Expected pinned pristine v2 artifact and32 unique development IFEval items');
+if (audit.engine_loads !== 0 || audit.target_forward_passes !== 0 || audit.runtime_sha256 !== hash(readFileSync('node_modules/@mlc-ai/web-llm-next/lib/index.js')))
+  throw Error('Exact tokenizer-only runtime audit missing or changed');
+const counts = new Map(audit.counts.map(item => [item.item_id, item.rendered_input_tokens]));
+if (audit.counts.length !== counts.size) throw Error('Duplicate tokenizer audit rows');
+const origin = 'http://127.0.0.1:4198';
+const remap = url => origin + new URL(url).pathname;
+config.assets = config.assets.map(asset => ({ ...asset, url: remap(asset.url) }));
+config.model.modelUrl = remap(config.model.modelUrl);
+config.model.modelLib = remap(config.model.modelLib);
+for (const asset of config.assets) {
+  if (hash(readFileSync(resolve('public', '.' + new URL(asset.url).pathname))) !== asset.sha256)
+    throw Error('Asset changed from verified v2 artifact: ' + new URL(asset.url).pathname);
+}
+const tokenizerAsset = config.assets.find(a => a.url.endsWith('/tokenizer.json'));
+if (tokenizerAsset.sha256 !== audit.tokenizer_sha256) throw Error('Token audit used another tokenizer');
+config.study = 'ifeval-browser-v1';
+config.runId = 'ifeval-browser-v1-baseline';
+config.warmupPrompt = 'Reply with OK.';
+config.settings = { temperature:0, topP:1, seed:42, maxTokens:1024, contextWindow:4096,
+  warmups:1, warmupTokens:16, requestLimitMs:120000, thinking:false };
+config.totalLimitMs = 5400000;
+config.items = items.map(item => {
+  const tokens = counts.get(item.item_id);
+  if (!Number.isInteger(tokens) || tokens <= 0 || tokens + 1024 > 4096) throw Error('Missing or infeasible exact token count');
+  return { item_id:item.item_id, prompt:item.task_text, rendered_input_tokens:tokens };
+});
