+/** Exact installed WebLLM tokenizer, no engine, worker, GPU, or forward pass. */
+import { readFileSync, writeFileSync, mkdtempSync, rmSync } from 'node:fs';
+import { resolve, join } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import { tmpdir } from 'node:os';
+import { createHash } from 'node:crypto';
+const [tokenizerPath, configPath, itemsPath, outputPath] = process.argv.slice(2);
+if (!outputPath) throw Error('Usage: count-task-tokens.mjs TOKENIZER CHAT_CONFIG ITEMS OUTPUT');
+const runtimePath = resolve('node_modules/@mlc-ai/web-llm-next/lib/index.js');
+const runtimeBytes = readFileSync(runtimePath);
+const source = runtimeBytes.toString();
+const start = source.indexOf('var lib$1 = {exports: {}};');
+const endMarker = 'var libExports = requireLib();';
+const end = source.indexOf(endMarker, start) + endMarker.length;
+if (start < 0 || end < start) throw Error('Pinned tokenizer module boundaries unavailable');
+const directory = mkdtempSync(join(tmpdir(), 'ifeval-tokenizer-'));
+try {
+  const extracted = 'import { createRequire } from "node:module";\n' + source.slice(start, end) + '\nexport const Tokenizer = libExports.Tokenizer;\n';
+  const modulePath = join(directory, 'tokenizer.mjs');
+  writeFileSync(modulePath, extracted);
+  globalThis.location = { href: pathToFileURL(modulePath).href };
+  const { Tokenizer } = await import(pathToFileURL(modulePath).href);
+  const bytes = readFileSync(tokenizerPath);
+  const tokenizer = await Tokenizer.fromJSON(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength));
+  const c = JSON.parse(readFileSync(configPath)).conv_template;
+  const items = JSON.parse(readFileSync(itemsPath));
+  const counts = items.map(item => {
+    const segments = [c.system_template.replace('{system_message}', c.system_message),
+      c.roles.user + c.role_content_sep + item.prompt + c.seps[0],
+      c.roles.assistant + c.role_content_sep + '<think>\n\n</think>\n\n'];
+    const tokens = segments.flatMap(segment => Array.from(tokenizer.encode(segment)));
+    return { item_id: item.item_id, rendered_input_tokens: tokens.length,
+      token_ids_sha256: createHash('sha256').update(JSON.stringify(tokens)).digest('hex') };
+  });
+  tokenizer.dispose();
+  writeFileSync(outputPath, JSON.stringify({ schema: 'ifeval-browser-token-count-audit-v1',
+    runtime_sha256: createHash('sha256').update(runtimeBytes).digest('hex'),
+    extracted_tokenizer_module_sha256: createHash('sha256').update(extracted).digest('hex'),
+    tokenizer_sha256: createHash('sha256').update(bytes).digest('hex'),
+    method: 'Unmodified bundled WebLLM Tokenizer module; exact Conversation segments encoded separately; no engine or GPU API invoked',
+    engine_loads: 0, target_forward_passes: 0, counts }, null, 2) + '\n', { flag: 'wx' });
