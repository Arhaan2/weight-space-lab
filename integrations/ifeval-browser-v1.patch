+  ...readdirSync('public/benchmark-worker').filter(file => file.endsWith('.js')).sort().map(file => 'benchmark-worker/' + file)];
+config.servedBuild = files.map(file => ({ url:origin + '/' + file, sha256:hash(readFileSync('public/' + file)), kind:file.endsWith('.html') ? 'html' : 'javascript' }));
+delete config.configurationSha256;
+config.configurationSha256 = hash(JSON.stringify(sorted(config)));
+writeFileSync(outputPath, JSON.stringify(config, null, 2) + '\n', { flag:'wx', mode:0o600 });
