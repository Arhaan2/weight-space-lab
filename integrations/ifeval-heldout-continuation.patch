+
+const continuationFixture = () => ({ ...heldoutFixture(), evaluationStage: 'heldout-continuation',
+  arm: 'candidate', runId: 'ifeval-browser-v1-heldout-continuation-candidate',
+  originalScheduleOffset: 94, originalScheduleLength: 128,
+  integrationGate: { attemptId: 'candidate-1', codeVersionSha256: sha },
+  items: heldoutFixture().items.slice(94),
+});
+test('explicit candidate continuation retains only34 remaining slots and identical generation options', () => {
+  const original = taskEvaluationSchema.parse(heldoutFixture());
+  const continuation = taskEvaluationSchema.parse(continuationFixture());
+  assert.equal(continuation.arm, 'candidate');
+  assert.equal(continuation.originalScheduleOffset, 94);
+  assert.equal(continuation.originalScheduleLength, 128);
+  assert.deepEqual(continuation.items, original.items.slice(94));
+  assert.equal(taskPlan(continuation).measuredRequests, 34);
+  assert.equal(taskPlan(continuation).resetPolicy, 'resetChat before each frozen held-out continuation item; seed 42');
+  assert.deepEqual(taskGenerationOptions(continuation), taskGenerationOptions(original));
+  assert.deepEqual(taskGenerationOptions(continuation, true), taskGenerationOptions(original, true));
+  assert.equal(continuation.settings.warmups + continuation.items.length, 35);
+  assert.equal(continuation.settings.warmupTokens + continuation.items.length * continuation.settings.maxTokens, 34832);
+});
