@@ -0,0 +1,152 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  taskEvaluationSchema,
+  taskGenerationOptions,
+  taskPlan,
+} from "../../src/benchmark/task-evaluation/protocol";
+import { taskSample } from "../../src/benchmark/task-evaluation/records";
+import { defaultRunSettings } from "../../src/benchmark/protocol/settings";
+const sha = "a".repeat(64);
+const fixture = () => ({
+  schema: "weight-space-browser-task-v2",
+  runId: "fixture",
+  configurationSha256: sha,
+  arm: "baseline",
+  sourceCheckpointSha256: sha,
+  convertedArtifactSha256: sha,
+  model: {
+    id: `baseline-${sha.slice(0, 12)}`,
+    modelUrl: `http://127.0.0.1:4173/models/${sha}/resolve/${sha}/`,
+    modelLib: "http://127.0.0.1:4173/model.wasm",
+    quantization: "q4f16_1",
+    requiredFeatures: ["shader-f16"],
+    bufferSizeRequiredBytes: 1,
+  },
+  assets: ["config", "manifest", "tokenizer", "wasm"].map((n) => ({
+    url: `http://127.0.0.1:4173/${n}`,
+    sha256: sha,
+  })),
+  settings: { ...defaultRunSettings("task"), warmups: 0, maxTokens: 256 },
+  totalLimitMs: 600000,
+  items: [{ item_id: "dev-1", prompt: "Fixture only; no inference" }],
+});
+test("task mode preserves natural completion with explicit matched defaults and no warmups", () => {
+  const c = taskEvaluationSchema.parse(fixture());
+  assert.deepEqual(taskGenerationOptions(c), {
+    temperature: 0,
+    top_p: 1,
+    seed: 42,
+    max_tokens: 256,
+    extra_body: { enable_thinking: false },
+    presence_penalty: 0,
+    frequency_penalty: 0,
+    repetition_penalty: 1,
+    n: 1,
+    ignore_eos: false,
+  });
+  assert.equal(taskPlan(c).measuredRequests, 1);
+  assert.equal(defaultRunSettings("repeat").warmups, 1);
+});
+test("rejects remote assets, warmups, shared artifact identity, duplicates and insufficient cleanup time", () => {
+  for (const mutate of [
+    (c: any) => {
+      c.assets[0].url = "https://example.com/weights";
+    },
+    (c: any) => {
+      c.settings.warmups = 1;
+    },
+    (c: any) => {
+      c.model.id = "baseline";
+    },
+    (c: any) => {
+      c.items.push(c.items[0]);
+    },
+    (c: any) => {
+      c.totalLimitMs = 70000;
+    },
+  ]) {
+    const c = fixture();
+    mutate(c);
+    assert.equal(taskEvaluationSchema.safeParse(c).success, false);
+  }
+});
+const response = () => ({
+  itemId: "dev-1",
+  output: "\\boxed{4}",
+  finish: "stop",
+  tokens: 8,
+  inputTokens: 10,
+  responseMs: 123,
+  loadMs: 1000,
+  error: null,
+  stopReason: null,
+  stopStatus: "cancelled",
+  submittedBatches: 2,
+});
+test("length and malformed answers remain evaluated but not valid natural completions", () => {
+  const length = taskSample({ ...response(), finish: "length" });
+  assert.equal(length.finish_reason, "length");
+  assert.equal(length.truncated, true);
+  assert.equal(length.execution_error, null);
+  assert.equal(length.valid_completion, false);
+  const malformed = taskSample({ ...response(), output: "\uFFFD" });
+  assert.equal(malformed.finish_reason, "stop");
+  assert.equal(malformed.valid_completion, false);
+  assert.equal(malformed.execution_error, null);
+});
+test("stream errors and cancellation preserve partial raw output and unknown token count", () => {
+  const failed = taskSample({
+    ...response(),
+    output: "partial",
+    tokens: null,
+    error: "device lost",
+    finish: "unknown",
+  });
+  assert.equal(failed.raw_output, "partial");
+  assert.equal(failed.generated_tokens, null);
+  assert.equal(failed.finish_reason, "error");
+  const cancelled = taskSample({
+    ...response(),
+    output: "part",
+    stopReason: "operator stop",
+  });
+  assert.equal(cancelled.raw_output, "part");
+  assert.equal(cancelled.cancelled, true);
+  assert.equal(cancelled.finish_reason, "cancelled");
+  assert.equal(
+    taskSample({ ...response(), finish: "unknown" }).finish_reason,
+    "error",
+  );
+  assert.equal(
+    taskSample({ ...response(), submittedBatches: 0 })
+      .local_webgpu_inference_observed,
+    false,
+  );
+});
+
+test("local cache URL must survive installed WebLLM cleanModelUrl unchanged", () => {
+  const c = fixture();
+  c.model.modelUrl = `http://127.0.0.1:4173/models/${sha}/`;
+  assert.equal(taskEvaluationSchema.safeParse(c).success, false);
+  c.model.modelUrl = `http://127.0.0.1:4173/models/${sha}/resolve/${sha}/`;
+  assert.equal(taskEvaluationSchema.safeParse(c).success, true);
+});
+test("device loss is an error while response deadline is timeout", () => {
+  assert.equal(
+    taskSample({
+      ...response(),
+      stopStatus: "failed",
+      stopReason: "WebGPU device lost: unknown",
+    }).finish_reason,
+    "error",
+  );
+  assert.equal(
+    taskSample({
+      ...response(),
+      stopStatus: "failed",
+      stopReason: "Request exceeded 60-second limit",
+    }).finish_reason,
+    "timeout",
+  );
+});
