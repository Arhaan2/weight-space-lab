+import assert from "node:assert/strict";
+import test from "node:test";
+import { createHash } from "node:crypto";
+import { fetchOnlyPreflight } from "../../src/benchmark/task-evaluation/preflight";
+import { defaultRunSettings } from "../../src/benchmark/protocol/settings";
+const origin = "http://127.0.0.1:4197";
+const sha = "a".repeat(64);
+const base = `/models/${sha}/resolve/${sha}/`;
+function fixture() {
+  const files = new Map([
+    [
+      "/task-evaluation.html",
+      [
+        "text/html",
+        "<!doctype html><script type='module' src='/task-evaluation.js'></script>",
+      ],
+    ],
+    ["/task-evaluation.js", ["text/javascript", "export const ready=true;"]],
+    [
+      "/benchmark-worker/benchmark.worker.js",
+      ["text/javascript", 'import("./runtime.js");'],
+    ],
+    [
+      "/benchmark-worker/runtime.js",
+      ["application/javascript", "export const engine='fixture';"],
+    ],
+    [
+      base + "mlc-chat-config.json",
+      [
+        "application/json",
+        JSON.stringify({ tokenizer_files: ["tokenizer.json"] }),
+      ],
+    ],
+    [
+      base + "tensor-cache.json",
+      [
+        "application/json",
+        JSON.stringify({ records: [{ dataPath: "params_shard_0.bin" }] }),
+      ],
+    ],
+    [base + "tokenizer.json", ["application/json", "{}"]],
+    ["/model.wasm", ["application/wasm", "\0asm"]],
+    [
+      base + "params_shard_0.bin",
+      ["application/octet-stream", "weights-fixture"],
+    ],
+  ]);
+  const assets = [...files].map(([path, [mime, body]]) => ({
+    url: origin + path,
+    sha256: createHash("sha256").update(body).digest("hex"),
+    kind: mime === "text/html" ? "html" : "javascript",
+  }));
+  return {
+    files,
+    config: {
+      schema: "weight-space-browser-task-v2",
+      runId: "preflight-fixture",
+      configurationSha256: sha,
+      arm: "baseline",
+      sourceCheckpointSha256: sha,
+      convertedArtifactSha256: sha,
+      integrationGate: {
+        attemptId: "fixture",
+        codeVersionSha256: sha,
+        loadOnly: false,
+      },
+      servedBuild: assets.slice(0, 4),
+      assets: assets.slice(4),
+      model: {
+        id: `baseline-${sha.slice(0, 12)}`,
+        modelUrl: `${origin}/models/${sha}/resolve/${sha}/`,
+        modelLib: origin + "/model.wasm",
+        quantization: "q4f16_1",
+        requiredFeatures: ["shader-f16"],
+        bufferSizeRequiredBytes: 1,
+      },
+      settings: { ...defaultRunSettings("task"), warmups: 0, maxTokens: 256 },
+      totalLimitMs: 600000,
+      items: [{ item_id: "fixture", prompt: "No inference fixture" }],
+    },
+  };
+}
+async function environment(
+  run: (f: ReturnType<typeof fixture>) => Promise<void>,
+) {
+  const oldFetch = globalThis.fetch,
+    oldLocation = (globalThis as any).location,
+    oldWorker = (globalThis as any).Worker;
+  const f = fixture();
+  (globalThis as any).location = { origin };
+  (globalThis as any).Worker = class {
+    constructor() {
+      throw Error("A fetch-only preflight must never instantiate Worker");
+    }
+  };
+  globalThis.fetch = async (url, init) => {
+    assert.equal(init?.cache, "no-store");
+    assert.equal(init?.redirect, "error");
+    const value = f.files.get(new URL(String(url)).pathname);
+    const response = new Response(value?.[1] ?? "missing", {
+      status: value ? 200 : 404,
+      headers: { "content-type": value?.[0] ?? "text/plain" },
+    });
+    Object.defineProperty(response, "url", { value: String(url) });
+    return response;
+  };
+  try {
+    await run(f);
+  } finally {
+    globalThis.fetch = oldFetch;
+    (globalThis as any).location = oldLocation;
+    (globalThis as any).Worker = oldWorker;
+  }
+}
+test("fetch-only checks actual bytes and imported build closure without creating a worker", () =>
+  environment(async ({ config }) => {
+    const report = await fetchOnlyPreflight(config);
+    assert.equal(report.status, "passed");
+    assert.equal(report.engine_loads, 0);
+    assert.equal(report.generation_dispatches, 0);
+    assert.equal(report.checks.length, 9);
+  }));
+test("HTML fallbacks with 200 status cannot masquerade as model or JavaScript files", () =>
+  environment(async ({ config, files }) => {
+    files.set("/model.wasm", [
+      "application/wasm",
+      "<!doctype html><html>SPA fallback</html>",
+    ]);
+    await assert.rejects(fetchOnlyPreflight(config), /HTML fallback/);
+  }));
+test("changed served runtime and omitted runtime chunk both fail before any inference", () =>
+  environment(async ({ config, files }) => {
+    files.set("/benchmark-worker/runtime.js", [
+      "application/javascript",
+      "changed",
+    ]);
+    await assert.rejects(fetchOnlyPreflight(config), /SHA256 mismatch/);
+    config.servedBuild = config.servedBuild.slice(0, 3);
+    await assert.rejects(
+      fetchOnlyPreflight(config),
+      /omits imported JavaScript/,
+    );
+  }));
+test("HTTP failure, invalid JSON, wrong MIME and remote origin fail closed", () =>
+  environment(async ({ config, files }) => {
+    const original = files.get(base + "mlc-chat-config.json")!;
+    files.delete(base + "mlc-chat-config.json");
+    await assert.rejects(fetchOnlyPreflight(config), /HTTP 404/);
+    files.set(base + "mlc-chat-config.json", ["application/json", "broken"]);
+    await assert.rejects(fetchOnlyPreflight(config), SyntaxError);
+    files.set(base + "mlc-chat-config.json", ["text/plain", "{}"]);
+    await assert.rejects(fetchOnlyPreflight(config), /JSON MIME/);
+    files.set(base + "mlc-chat-config.json", original);
+    config.servedBuild[0].url = "https://example.com/app";
+    await assert.rejects(
+      fetchOnlyPreflight(config),
+      /actual loopback browser origin/,
+    );
+  }));
