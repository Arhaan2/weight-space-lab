+  result.generatedTokens =
+    result.generatedTokens === null ||
+    result.outputs.some((s) => s.generated_tokens == null) ||
+    (generationAcknowledged &&
+      result.status !== "completed" &&
+      !result.outputs.length)
+      ? null
+      : result.outputs.reduce((n, s) => n + s.generated_tokens, 0);
+  result.configuration_sha256 = config.configurationSha256;
+  result.source_checkpoint_sha256 = config.sourceCheckpointSha256;
+  result.converted_artifact_sha256 = config.convertedArtifactSha256;
+  result.driver = {
+    started_epoch_ms: started,
+    ended_epoch_ms: Date.now(),
+    total_ms: Date.now() - started,
+    chrome_pid: chrome?.pid ?? null,
+    chrome_exit_code: chrome?.exitCode ?? null,
+    chrome_signal: chrome?.signalCode ?? null,
+    server_exit_code: server?.exitCode ?? null,
+    server_signal: server?.signalCode ?? null,
+    no_retries: true,
+    warmups: 0,
+    mode: dispatch.mode,
+    attempt_id: attemptId,
+    code_version_sha256: codeVersionSha256,
+    load_intent_observed: gateSeen.has("load"),
+    load_acknowledged: loadAcknowledged,
+    generation_intent_observed: gateSeen.has("generation"),
+    generation_acknowledged: generationAcknowledged,
+    generation_call_intent_observed: generationCallObserved,
+    deadline_epoch_ms: globalDeadline ?? null,
+  };
+  result.cleanup = {
+    ...result.cleanup,
+    chrome_exit_confirmed: chrome
+      ? chrome.exitCode !== null || chrome.signalCode !== null
+      : true,
+    local_harness_exit_confirmed: server
+      ? server.exitCode !== null || server.signalCode !== null
+      : true,
+  };
+  if (
+    result.status === "completed" &&
+    !(
+      (fetchOnly || result.cleanup.unload_confirmed) &&
+      result.cleanup.chrome_exit_confirmed &&
+      result.cleanup.local_harness_exit_confirmed
+    )
+  ) {
+    result.status = "failed";
+    result.cleanup_error =
+      "Cleanup did not confirm unload and child-process exits";
+  }
+  result.cleanup.owned_browser_and_worker_resources_released =
+    result.cleanup.chrome_exit_confirmed &&
+    result.cleanup.local_harness_exit_confirmed;
+  result.cleanup.release_scope =
+    "Dedicated browser process/profile, all of its page/worker/device resources, and this local harness only; unrelated browser data untouched";
+  for (const sample of result.outputs) sample.cleanup = result.cleanup;
+  durableJson(resultFile, result);
+  process.exitCode = result.status === "completed" ? 0 : 1;
+}
diff --git a/src/benchmark/task-evaluation/artifacts.ts b/src/benchmark/task-evaluation/artifacts.ts
