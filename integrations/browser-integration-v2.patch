diff --git a/scripts/preflight-task-assets.mjs b/scripts/preflight-task-assets.mjs
new file mode 100644
index 0000000..5d6c536
--- /dev/null
+++ b/scripts/preflight-task-assets.mjs
@@ -0,0 +1,86 @@
+/** Offline/local-HTTP preparation only: no browser, model load or target generation. */
+import { readFileSync, writeFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { startServer } from "../harness/controller/server.ts";
+import { taskEvaluationSchema } from "../src/benchmark/task-evaluation/protocol.ts";
+const paths = process.argv.slice(2);
+if (!paths.length)
+  throw Error(
+    "Usage: node --import tsx scripts/preflight-task-assets.mjs CONFIG_JSON [CONFIG_JSON...]",
+  );
+const configs = paths.map((p) =>
+  taskEvaluationSchema.parse(JSON.parse(readFileSync(p, "utf8"))),
+);
+const source = readFileSync(
+  "node_modules/@mlc-ai/web-llm-next/lib/index.js",
+  "utf8",
+);
+const helper = source.match(
+  /function cleanModelUrl\(modelUrl\) \{[\s\S]+?\n\}/,
+)?.[0];
+if (!helper) throw Error("Installed URL normalization helper unavailable");
+const cleanModelUrl = new Function(helper + "; return cleanModelUrl;")();
+const origin = new URL(configs[0].model.modelUrl).origin;
+for (const c of configs) {
+  if (cleanModelUrl(c.model.modelUrl) !== c.model.modelUrl)
+    throw Error("Runtime would rewrite frozen local model URL");
+  if (new URL(c.model.modelUrl).origin !== origin)
+    throw Error("Use one loopback origin for matched arms");
+}
+const { server } = await startServer({
+  port: Number(new URL(origin).port),
+  siteOnly: true,
+  out: "public",
+});
+const report = {
+  schema: "browser-runtime-local-http-preflight-v1",
+  runtimePackageSha256: createHash("sha256").update(source).digest("hex"),
+  validationScope:
+    "Local Node HTTP asset fetch/hash and installed runtime URL helper only; no browser/model load/inference",
+  browserValidation: "not_run_after_terminal_integration_check",
+  results: [],
+};
+try {
+  for (const c of configs) {
+    for (const a of c.assets) {
+      const r = await fetch(a.url, { redirect: "error", cache: "no-store" });
+      if (!r.ok) throw Error(`HTTP ${r.status}: ${a.url}`);
+      const bytes = await r.arrayBuffer();
+      const actual = createHash("sha256")
+        .update(new Uint8Array(bytes))
+        .digest("hex");
+      if (actual !== a.sha256) throw Error("HTTP asset hash mismatch");
+      if (
+        a.url.endsWith(".wasm") &&
+        r.headers.get("content-type") !== "application/wasm"
+      )
+        throw Error("Incorrect WASM MIME");
+      report.results.push({
+        arm: c.arm,
+        url: a.url,
+        sha256: actual,
+        bytes: bytes.byteLength,
+        contentType: r.headers.get("content-type"),
+      });
+    }
+  }
+  report.status = "passed";
+} catch (error) {
+  report.status = "failed";
+  report.error = String(error);
+  process.exitCode = 1;
+} finally {
+  await new Promise((resolve) => server.close(resolve));
+}
+writeFileSync(
+  "../local-http-preflight.json",
+  JSON.stringify(report, null, 2) + "\n",
+);
+console.log(
+  JSON.stringify({
+    status: report.status,
+    verifiedAssets: report.results.length,
+    inferenceSequences: 0,
+    browserLoads: 0,
+  }),
+);
