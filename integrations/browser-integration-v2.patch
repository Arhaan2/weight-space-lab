new file mode 100644
index 0000000..63c0333
--- /dev/null
+++ b/tests/unit/task-assets.test.ts
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { guardTaskAssets } from "../../src/benchmark/task-evaluation/artifacts";
+const source = readFileSync(
+  "node_modules/@mlc-ai/web-llm-next/lib/index.js",
+  "utf8",
+);
+const awaiter = (self: any, args: any, _P: any, generator: any) =>
+  new Promise((resolve, reject) => {
+    const g = generator.apply(self, args || []);
+    const next = (method: string, value?: any) => {
+      let result;
+      try {
+        result = g[method](value);
+      } catch (e) {
+        reject(e);
+        return;
+      }
+      if (result.done) resolve(result.value);
+      else
+        Promise.resolve(result.value).then(
+          (v) => next("next", v),
+          (e) => next("throw", e),
+        );
+    };
+    next("next");
+  });
+function method(className: string, end: string) {
+  const start = source.indexOf(
+    "addToCache(url, storetype, signal) {",
+    source.indexOf(`class ${className} {`),
+  );
+  const finish = source.indexOf(end, start);
+  assert.ok(start >= 0 && finish > start);
+  const body = source.slice(start, finish).trim();
+  return new Function("__awaiter", `return ({${body}}).addToCache;`)(awaiter);
+}
+test("installed WebLLM cache API bypasses fetch while selected IndexedDB path consumes guarded bytes", async () => {
+  const oldFetch = globalThis.fetch,
+    oldLocation = (globalThis as any).location;
+  const url = "http://127.0.0.1:4187/model/tokenizer.json",
+    bytes = new TextEncoder().encode('{"fixture":true}');
+  let fetches = 0,
+    stored: any;
+  globalThis.fetch = async () => {
+    fetches++;
+    return new Response(bytes);
+  };
+  (globalThis as any).location = { href: url };
+  const guard = guardTaskAssets(
+    {
+      assets: [
+        { url, sha256: createHash("sha256").update(bytes).digest("hex") },
+      ],
+    } as any,
+    () => {},
+  );
+  try {
+    const add = method("ArtifactIndexedDBCache", "\n\t\t        hasAllKeys");
+    await add.call(
+      {
+        initDB: async () => {},
+        isUrlInDB: async () => false,
+        addToIndexedDB: async (_u: any, r: Response) => {
+          stored = await r.json();
+        },
+      },
+      url,
+      "json",
+    );
+    assert.equal(fetches, 1);
+    assert.deepEqual(stored, { fixture: true });
+    guard.requireAll();
+    await assert.rejects(fetch(url + "-unlisted"), /Unlisted/);
+  } finally {
+    guard.restore();
+    globalThis.fetch = oldFetch;
+    (globalThis as any).location = oldLocation;
+  }
+  const cacheClass = source.slice(
+    source.indexOf("class ArtifactCache {"),
+    source.indexOf("class ArtifactIndexedDBCache {"),
+  );
+  assert.match(cacheClass, /yield this\.cache\.add\(request\)/);
+});
+test("changed bytes are rejected before IndexedDB stores an artifact", async () => {
+  const oldFetch = globalThis.fetch,
+    oldLocation = (globalThis as any).location;
+  const url = "http://127.0.0.1:4187/model/tokenizer.json";
+  let stored = false;
+  globalThis.fetch = async () => new Response("changed");
+  (globalThis as any).location = { href: url };
+  const guard = guardTaskAssets(
+    { assets: [{ url, sha256: "a".repeat(64) }] } as any,
+    () => {},
+  );
+  try {
+    const add = method("ArtifactIndexedDBCache", "\n\t\t        hasAllKeys");
+    await assert.rejects(
+      add.call(
+        {
+          initDB: async () => {},
+          isUrlInDB: async () => false,
+          addToIndexedDB: async () => {
+            stored = true;
+          },
+        },
+        url,
+        "json",
+      ),
+      /SHA256 mismatch/,
+    );
+    assert.equal(stored, false);
+    assert.throws(() => guard.requireAll(), /did not fetch all/);
+  } finally {
+    guard.restore();
+    globalThis.fetch = oldFetch;
+    (globalThis as any).location = oldLocation;
+  }
+});
diff --git a/tests/unit/task-evaluation.test.ts b/tests/unit/task-evaluation.test.ts
