+/** Pure local artifact/config preparation. Does not authorize or perform inference. */
+import {
+  readFileSync,
+  writeFileSync,
+  existsSync,
+  mkdirSync,
+  copyFileSync,
+  realpathSync,
+  constants,
+} from "node:fs";
+import { resolve, relative, dirname, sep } from "node:path";
+import { createHash } from "node:crypto";
+import { taskEvaluationSchema } from "../src/benchmark/task-evaluation/protocol.ts";
+const args = process.argv.slice(2);
+const option = (name, fallback) => {
+  const i = args.indexOf(name);
+  if (i >= 0 && !args[i + 1]) throw Error(`Missing ${name}`);
+  return i >= 0 ? args[i + 1] : fallback;
+};
+const required = (name) => {
+  const value = option(name);
+  if (!value) throw Error(`Required ${name}`);
+  return value;
+};
+const hash = (bytes) => createHash("sha256").update(bytes).digest("hex");
+const ordered = (v) =>
+  Array.isArray(v)
+    ? v.map(ordered)
+    : v && typeof v === "object"
+      ? Object.fromEntries(
+          Object.keys(v)
+            .sort()
+            .map((k) => [k, ordered(v[k])]),
+        )
+      : v;
+const canonical = (v) =>
+  JSON.stringify(ordered(v)).replace(
+    /[\u007f-\uffff]/g,
+    (c) => "\\u" + c.charCodeAt(0).toString(16).padStart(4, "0"),
+  );
+const arm = required("--arm"),
+  out = resolve(required("--output"));
+if (existsSync(out))
+  throw Error("Prepared config already exists; use a fresh output path");
+const source = JSON.parse(
+  readFileSync(required("--artifact-manifest"), "utf8"),
+);
+const artifact = source.arms ? source.arms[arm] : source;
+if (
+  !artifact?.files ||
+  hash(canonical(artifact.files)) !== artifact.artifact_sha256
+)
+  throw Error("Converted artifact manifest digest mismatch");
+const sourceDir = realpathSync(artifact.path);
+for (const [name, identity] of Object.entries(artifact.files)) {
+  const file = realpathSync(resolve(sourceDir, name)),
+    rel = relative(sourceDir, file);
+  if (rel.startsWith(".." + sep) || rel === ".." || rel.startsWith(sep))
+    throw Error("Artifact file escapes source folder");
+  const bytes = readFileSync(file);
+  if (bytes.length !== identity.size_bytes || hash(bytes) !== identity.sha256)
+    throw Error("Artifact bytes do not match manifest: " + name);
+}
+const input = JSON.parse(readFileSync(required("--tasks"), "utf8"));
+const items = input.map((item) => {
+  if (
+    item.split !== "development" ||
+    item.benchmark !== "math" ||
+    item.messages?.length !== 1 ||
+    item.messages[0].role !== "user"
+  )
+    throw Error("Only the frozen development math task format is accepted");
+  return { item_id: item.item_id, prompt: item.messages[0].content };
+});
+const origin = `http://127.0.0.1:${Number(option("--port", "4187"))}`;
+const modelUrl = `${origin}/models/${artifact.model_id}/resolve/${artifact.artifact_sha256}/`;
+const library = artifact.files["model.wasm"];
+if (!library) throw Error("Artifact lacks matched compiled model library");
