index 0000000..fb8d1c7
--- /dev/null
+++ b/src/benchmark/task-evaluation/artifacts.ts
@@ -0,0 +1,115 @@
+import type { TaskEvaluation } from "./protocol";
+
+/** Fail closed on nonlocal, unlisted, or changed assets before the engine consumes bytes. */
+export function guardTaskAssets(
+  task: TaskEvaluation,
+  send: (type: string, data: unknown) => void,
+) {
+  const expected = new Map(task.assets.map((a) => [a.url, a.sha256]));
+  const verified = new Set<string>();
+  let chatConfig: any;
+  let failure: { kind: string; url: string; message: string } | null = null;
+  const fail = (kind: string, url: string, message: string): never => {
+    failure = { kind, url, message };
+    throw Error(message);
+  };
+  const original = globalThis.fetch.bind(globalThis);
+  globalThis.fetch = async (input, init) => {
+    const url = new URL(
+      typeof input === "string"
+        ? input
+        : input instanceof URL
+          ? input.href
+          : input.url,
+      location.href,
+    ).href;
+    const wanted = expected.get(url);
+    if (!wanted)
+      fail(
+        "unlisted-url",
+        url,
+        `Unlisted task asset/network request blocked: ${url}`,
+      );
+    const method =
+      init?.method ?? (input instanceof Request ? input.method : "GET");
+    if (method !== "GET") throw Error("Task assets are read-only");
+    let response: Response;
+    try {
+      response = await original(input, {
+        ...init,
+        redirect: "error",
+        cache: "no-store",
+      });
+    } catch (error) {
+      if (error instanceof TypeError && /fetch/i.test(error.message))
+        fail(
+          "network-fetch",
+          url,
+          `Task asset fetch failed: ${url}: ${error.message}`,
+        );
+      throw error;
+    }
+    if (!response.ok)
+      fail("http-status", url, `Task asset HTTP ${response.status}: ${url}`);
+    const bytes = await response.arrayBuffer();
+    const digest = Array.from(
+      new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)),
+      (b) => b.toString(16).padStart(2, "0"),
+    ).join("");
+    if (digest !== wanted)
+      fail("asset-identity", url, `Task asset SHA256 mismatch: ${url}`);
+    verified.add(url);
+    if (url.endsWith("/mlc-chat-config.json")) {
+      chatConfig = JSON.parse(new TextDecoder().decode(bytes));
+      send("task-chat-config", chatConfig);
+    }
+    send("asset-verified", { url, sha256: digest, bytes: bytes.byteLength });
+    return new Response(bytes, {
+      status: response.status,
+      statusText: response.statusText,
+      headers: response.headers,
+    });
+  };
+  return {
+    get failure() {
+      return failure;
+    },
+    renderedPrompt(prompt: string) {
+      const c = chatConfig?.conv_template;
+      if (
+        !c ||
+        chatConfig.conv_config ||
+        c.add_role_after_system_message !== true ||
+        c.system_prefix_token_ids?.length ||
+        c.role_templates?.user !== "{user_message}" ||
+        c.roles?.user !== "<|im_start|>user" ||
+        c.roles?.assistant !== "<|im_start|>assistant" ||
+        c.role_content_sep !== "\n" ||
+        c.seps?.[0] !== "<|im_end|>\n"
+      )
+        throw Error(
+          "Task prompt audit requires the frozen Qwen3.5 ChatML template",
+        );
+      return (
+        c.system_template.replace("{system_message}", c.system_message) +
+        c.roles.user +
+        c.role_content_sep +
+        prompt +
+        c.seps[0] +
+        c.roles.assistant +
+        c.role_content_sep +
+        "<think>\n\n</think>\n\n"
+      );
+    },
+    requireAll() {
+      const missing = [...expected.keys()].filter((url) => !verified.has(url));
+      if (missing.length)
+        throw Error(
+          `Runtime did not fetch all frozen assets; cached or mismatched load: ${missing.join(", ")}`,
+        );
+    },
+    restore() {
+      globalThis.fetch = original;
+    },
+  };
+}
diff --git a/src/benchmark/task-evaluation/client.ts b/src/benchmark/task-evaluation/client.ts
new file mode 100644
index 0000000..498b49b
--- /dev/null
+++ b/src/benchmark/task-evaluation/client.ts
@@ -0,0 +1,281 @@
+import {
+  taskEvaluationSchema,
+  taskPlan,
+  type TaskEvaluation,
+} from "./protocol";
+import { sampleSchema } from "../schemas/report";
+import { clockMs } from "../metrics/browser-profiler";
+import { fetchOnlyPreflight } from "./preflight";
+
+type Event = { type: string; data: any; receivedEpochMs: number };
+let used = false;
+let activeWorker: Worker | undefined;
+let activeAckReceiver: ((ack: any) => void) | undefined;
+const status = (text: string) => {
+  const node = document.getElementById("status");
+  if (node) node.textContent = text;
+};
+async function run(input: unknown) {
+  if (used)
+    throw Error(
+      "This page already consumed its one task-session dispatch; retries are disabled",
+    );
+  const task = taskEvaluationSchema.parse(input);
+  if (!task.integrationGate || !task.servedBuild?.length)
+    throw Error(
+      "V2 execution requires durable dispatch gates and frozen served-build identities",
+    );
+  if (
+    new URL(task.model.modelUrl).origin !== location.origin ||
+    task.assets.some((a) => new URL(a.url).origin !== location.origin)
+  )
+    throw Error("All task assets must share the local harness origin");
+  used = true;
+  status(`Loading ${task.arm}; 0 of ${task.items.length} items evaluated`);
+  const events: Event[] = [],
+    samples: any[] = [];
+  const startedEpochMs = clockMs();
+  let partialOutput = "",
+    requestIndex = 0,
+    requestStart = 0;
+  let loadMs: number | null = null;
+  const worker = new Worker("/benchmark-worker/benchmark.worker.js", {
+    type: "module",
+  });
+  activeWorker = worker;
+  const emit = (type: string, data: any) => {
+    const event = { type, data, receivedEpochMs: Date.now() };
+    events.push(event);
+    const binding = (globalThis as any).taskEvent;
+    if (binding) binding(JSON.stringify(event));
+  };
+  return await new Promise<any>((resolve) => {
+    let finished = false;
+    const complete = (done: any, forced = false) => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(cancelTimer);
+      clearTimeout(forceTimer);
+      worker.terminate();
+      activeWorker = undefined;
+      activeAckReceiver = undefined;
+      if (
+        requestIndex &&
+        !samples.some(
+          (s) => s.item_id === task.items[requestIndex - 1]?.item_id,
+        )
+      ) {
+        samples.push({
+          item_id: task.items[requestIndex - 1].item_id,
+          raw_output: partialOutput,
+          finish_reason: "error",
+          generated_tokens: null,
+          input_tokens: null,
+          response_latency_ms: Math.max(
+            0,
+            clockMs() - startedEpochMs - requestStart,
+          ),
+          loading_time_ms: loadMs,
+          execution_error: done.reason,
+          cancelled: done.status === "cancelled",
+          partial_output_scope:
+            "last worker output event; up to 250ms stream lag",
+        });
+      }
+      const cleanup = {
+        unload_confirmed: Boolean(done.unloadConfirmed),
+        worker_terminated: true,
+        forced_termination: forced,
+      };
+      const resourceEvents = events.filter((e) =>
+        ["point", "signal", "event", "network"].includes(e.type),
+      );
+      const outputs = samples.map((s) => ({
+        ...s,
+        cleanup,
+        resources: {
+          scope: "inference worker",
+          signals: resourceEvents
+            .filter((e) => e.type === "signal")
+            .map((e) => e.data),
+          samples: resourceEvents
+            .filter((e) => e.type === "point")
+            .map((e) => e.data),
+          note: "GPUBuffer descriptor accounting is not physical VRAM. WASM address space and JS heap are separate. Native MPS counters are not used.",
+        },
+      }));
+      const result = {
+        schema: "weight-space-browser-task-result-v2",
+        run_id: task.runId,
+        arm: task.arm,
+        configuration_sha256: task.configurationSha256,
+        source_checkpoint_sha256: task.sourceCheckpointSha256,
+        converted_artifact_sha256: task.convertedArtifactSha256,
+        user_agent: navigator.userAgent,
+        platform: navigator.platform,
+        hardware_concurrency: navigator.hardwareConcurrency,
+        outputs,
+        events,
+        done,
+        cleanup,
+        started_epoch_ms: startedEpochMs,
+        ended_epoch_ms: clockMs(),
+        counts: {
+          scheduled: task.items.length,
+          evaluated: outputs.length,
+          interrupted: outputs.filter((x) =>
+            ["error", "timeout", "cancelled", "interrupted"].includes(
+              x.finish_reason,
+            ),
+          ).length,
+          unrun: task.items.length - outputs.length,
+        },
+      };
+      emit("task-terminal", { done, cleanup, counts: result.counts });
+      status(
+        `${done.status}: ${outputs.length} evaluated; ${task.items.length - outputs.length} unrun. Worker terminated.`,
+      );
+      resolve(result);
+    };
+    let cancelTimer = setTimeout(
+      () =>
+        worker.postMessage({
+          type: "cancel",
+          reason: "Frozen task session deadline; cleanup reserved",
+          status: "interrupted",
+        }),
+      task.totalLimitMs - 15000,
+    );
+    let forceTimer = setTimeout(
+      () =>
+        complete(
+          {
+            status: "interrupted",
+            reason: "Worker cleanup deadline exceeded",
+            unloadConfirmed: false,
+            completedRequests: samples.length,
+            totalMs: clockMs() - startedEpochMs,
+          },
+          true,
+        ),
+      task.totalLimitMs - 5000,
+    );
+    activeAckReceiver = (ack: any) => {
+      if (ack.approved && ack.kind === "load") {
+        clearTimeout(cancelTimer);
+        clearTimeout(forceTimer);
+        const remaining = ack.deadline_epoch_ms - Date.now();
+        cancelTimer = setTimeout(
+          () =>
+            worker.postMessage({
+              type: "cancel",
+              reason: "Global v2 deadline; cleanup reserved",
+              status: "interrupted",
+            }),
+          Math.max(0, remaining - 15000),
+        );
+        forceTimer = setTimeout(
+          () =>
+            complete(
+              {
+                status: "interrupted",
+                reason: "Global v2 cleanup deadline exceeded",
+                unloadConfirmed: false,
+                completedRequests: samples.length,
+                totalMs: clockMs() - startedEpochMs,
+              },
+              true,
+            ),
+          Math.max(0, remaining - 5000),
+        );
+      }
+      worker.postMessage({ type: "gate-ack", ack });
+    };
+    worker.onmessage = (e) => {
+      try {
+        const { type, data } = e.data;
+        emit(type, data);
+        if (type === "sample") sampleSchema.parse(data);
+        if (type === "loaded") loadMs = data;
+        if (type === "output") partialOutput = data;
+        if (type === "event" && data.type === "request-start") {
+          requestIndex = data.requestIndex;
+          requestStart = data.tMs;
+          partialOutput = "";
+        }
+        if (type === "task-sample") {
+          samples.push(data);
+          status(
+            `${task.arm}: ${samples.length} of ${task.items.length} evaluated`,
+          );
+        }
+        if (type === "done") complete(data);
+      } catch (error) {
+        emit("task-validation-error", { error: String(error) });
+        complete(
+          {
+            status: "failed",
+            reason: String(error),
+            unloadConfirmed: false,
+            completedRequests: samples.length,
+            totalMs: clockMs() - startedEpochMs,
+          },
+          true,
+        );
+      }
+    };
+    worker.onerror = (e) =>
+      complete(
+        {
+          status: "failed",
+          reason: e.message,
+          unloadConfirmed: false,
+          completedRequests: samples.length,
+          totalMs: clockMs() - startedEpochMs,
+        },
+        true,
+      );
+    worker.postMessage({
+      type: "start",
+      taskEvaluation: task,
+      model: {
+        ...task.model,
+        runtime: "WebLLM 0.2.86",
+        thinkingDisabled: true,
+        record: {
+          model_id: task.model.id,
+          model: task.model.modelUrl,
+          model_lib: task.model.modelLib,
+          required_features: task.model.requiredFeatures,
+          buffer_size_required_bytes: task.model.bufferSizeRequiredBytes,
+          overrides: {
+            context_window_size: task.settings.contextWindow,
+            max_history_size: 1,
+          },
+        },
+      },
+      settings: task.settings,
+      workload: "task-evaluation",
+      plan: taskPlan(task),
+      startedEpochMs,
+      profiling: true,
+    });
+  });
+}
+(globalThis as any).browserTaskEvaluation = {
+  preflight: fetchOnlyPreflight,
+  approveGate: (ack: any) => {
+    if (!activeAckReceiver) throw Error("No live worker dispatch gate");
+    activeAckReceiver(ack);
+  },
+  run,
+  cancel: () =>
+    activeWorker?.postMessage({
+      type: "cancel",
+      reason: "Operator cancellation",
+      status: "cancelled",
+    }),
+};
+status(
+  "Ready. No model is loaded; task dispatch is controlled by the frozen local manifest.",
+);
diff --git a/src/benchmark/task-evaluation/preflight.ts b/src/benchmark/task-evaluation/preflight.ts
new file mode 100644
index 0000000..186d211
--- /dev/null
+++ b/src/benchmark/task-evaluation/preflight.ts
@@ -0,0 +1,164 @@
+import { taskEvaluationSchema } from "./protocol";
+
+/** Fetch bytes only. This function never creates a Worker, adapter, device or engine. */
+export async function fetchOnlyPreflight(input: unknown) {
+  const task = taskEvaluationSchema.parse(input);
+  if (!task.integrationGate || !task.servedBuild?.length)
+    throw Error(
+      "V2 requires frozen served-build identities and dispatch gates",
+    );
+  const origin = location.origin;
+  const rows = [
+    ...task.servedBuild,
+    ...task.assets.map((asset) => ({ ...asset, kind: "artifact" })),
+  ];
+  const results = [];
+  const parsedJson = new Map<string, any>();
+  for (const asset of rows) {
+    const url = new URL(asset.url, origin);
+    if (
+      url.origin !== origin ||
+      url.protocol !== "http:" ||
+      url.hostname !== "127.0.0.1"
+    )
+      throw Error("Preflight asset is not the actual loopback browser origin");
+    const response = await fetch(url.href, {
+      cache: "no-store",
+      redirect: "error",
+    });
+    if (!response.ok)
+      throw Error(`Fetch-only preflight HTTP ${response.status}: ${url.href}`);
+    if (response.url !== url.href)
+      throw Error("Preflight response URL differs");
+    const bytes = new Uint8Array(await response.arrayBuffer());
+    const mime =
+      response.headers
+        .get("content-type")
+        ?.split(";")[0]
+        .trim()
+        .toLowerCase() ?? "";
+    const head = new TextDecoder()
+      .decode(bytes.slice(0, 256))
+      .trimStart()
+      .toLowerCase();
+    if (
+      asset.kind !== "html" &&
+      (mime.includes("html") || /^<!doctype\s+html|^<html/.test(head))
+    )
+      throw Error(`Application HTML fallback masquerades as file: ${url.href}`);
+    if (asset.kind === "html" && mime !== "text/html")
+      throw Error("Application entrypoint MIME differs");
+    if (
+      asset.kind === "javascript" &&
+      !["text/javascript", "application/javascript"].includes(mime)
+    )
+      throw Error("Served JavaScript MIME differs");
+    if (asset.kind === "javascript") {
+      const source = new TextDecoder().decode(bytes);
+      const references = source.matchAll(
+        /(?:import\s*\(|from\s*)["']([^"']+\.js)["']/g,
+      );
+      for (const reference of references) {
+        const importedUrl = new URL(reference[1], url).href;
+        if (
+          !task.servedBuild.some(
+            (a) => a.url === importedUrl && a.kind === "javascript",
+          )
+        )
+          throw Error(
+            `Frozen served build omits imported JavaScript: ${importedUrl}`,
+          );
+      }
+    }
+    if (url.pathname.endsWith(".json")) {
+      if (mime !== "application/json") throw Error("JSON MIME differs");
+      parsedJson.set(url.href, JSON.parse(new TextDecoder().decode(bytes)));
+    }
+    if (
+      url.pathname.endsWith(".wasm") &&
+      (mime !== "application/wasm" ||
+        bytes[0] !== 0 ||
+        bytes[1] !== 97 ||
+        bytes[2] !== 115 ||
+        bytes[3] !== 109)
+    )
+      throw Error("WASM MIME or magic differs");
+    if (url.pathname.endsWith(".bin") && mime !== "application/octet-stream")
+      throw Error("Weight shard MIME differs");
+    const digest = [
+      ...new Uint8Array(await crypto.subtle.digest("SHA-256", bytes)),
+    ]
+      .map((x) => x.toString(16).padStart(2, "0"))
+      .join("");
+    if (digest !== asset.sha256)
+      throw Error(`Served content SHA256 mismatch: ${url.href}`);
+    results.push({
+      url: url.href,
+      status: response.status,
+      content_type: mime,
+      bytes: bytes.length,
+      sha256: digest,
+      kind: asset.kind,
+    });
+  }
+  const required = [
+    "/task-evaluation.html",
+    "/task-evaluation.js",
+    "/benchmark-worker/benchmark.worker.js",
+  ];
+  for (const path of required)
+    if (!task.servedBuild.some((a) => new URL(a.url).pathname === path))
+      throw Error("Frozen served application/worker entrypoint missing");
+  const modelBase = new URL(task.model.modelUrl, origin);
+  const configUrl = new URL("mlc-chat-config.json", modelBase).href;
+  const manifestUrl = new URL("tensor-cache.json", modelBase).href;
+  const modelConfig = parsedJson.get(configUrl),
+    tensorManifest = parsedJson.get(manifestUrl);
+  if (
+    !modelConfig?.tokenizer_files?.includes("tokenizer.json") ||
+    !Array.isArray(tensorManifest?.records)
+  )
+    throw Error(
+      "Resolved model configuration/tokenizer/tensor manifest is missing or incompatible with the frozen artifact",
+    );
+  const resolvedAssets = [
+    configUrl,
+    manifestUrl,
+    new URL("tokenizer.json", modelBase).href,
+    task.model.modelLib,
+    ...tensorManifest.records.map(
+      (record: any) => new URL(record.dataPath, modelBase).href,
+    ),
+  ];
+  for (const url of resolvedAssets)
+    if (!task.assets.some((asset) => asset.url === url))
+      throw Error(`Resolved runtime asset lacks a frozen identity: ${url}`);
+  return {
+    schema: "browser-v2-fetch-only-preflight",
+    status: "passed",
+    fetch_only: true,
+    engine_loads: 0,
+    generation_dispatches: 0,
+    arm: task.arm,
+    origin,
+    requested_artifact_sha256: task.convertedArtifactSha256,
+    code_version_sha256: task.integrationGate.codeVersionSha256,
+    resolved_model_base: modelBase.href,
+    resolved_asset_urls: resolvedAssets,
+    model_cache_identity: {
+      model_id: task.model.id,
+      model_url: task.model.modelUrl,
+      cache_backend: "indexeddb",
+      cache_key_scope:
+        "Full asset URLs; dedicated fresh browser profile supplied by host driver",
+    },
+    checks: results,
+    browser_user_agent: navigator.userAgent,
+    workers_created: 0,
+    engines_created: 0,
+    application_generations: 0,
+    gpu_requests: 0,
+    scope:
+      "Actual browser-origin fetch, content, MIME and SHA256 validation only; no model initialization",
+  };
+}
diff --git a/src/benchmark/task-evaluation/protocol.ts b/src/benchmark/task-evaluation/protocol.ts
new file mode 100644
index 0000000..7024a34
--- /dev/null
+++ b/src/benchmark/task-evaluation/protocol.ts
@@ -0,0 +1,130 @@
+import { z } from "zod";
+import { runSettingsSchema, generationOptions } from "../protocol/settings";
+import { planFor } from "../protocol/schedule";
+
+const sha = z.string().regex(/^[a-f0-9]{64}$/);
+export const taskEvaluationSchema = z
+  .object({
+    schema: z.literal("weight-space-browser-task-v2"),
+    runId: z.string().regex(/^[a-zA-Z0-9_-]+$/),
+    configurationSha256: sha,
+    arm: z.enum(["baseline", "candidate"]),
+    sourceCheckpointSha256: sha,
+    convertedArtifactSha256: sha,
+    integrationGate: z
+      .object({
+        attemptId: z.string().regex(/^[a-zA-Z0-9_-]+$/),
+        codeVersionSha256: sha,
+        loadOnly: z.boolean().default(false),
+      })
+      .optional(),
+    servedBuild: z
+      .array(
+        z.object({
+          url: z.string().url(),
+          sha256: sha,
+          kind: z.enum(["html", "javascript"]),
+        }),
+      )
+      .optional(),
+    model: z.object({
+      id: z.string().min(1),
+      modelUrl: z.string().url(),
+      modelLib: z.string().url(),
+      quantization: z.enum(["q4f16_1", "q0f16"]),
+      requiredFeatures: z.array(z.string()),
+      bufferSizeRequiredBytes: z.number().int().nonnegative(),
+    }),
+    assets: z.array(z.object({ url: z.string().url(), sha256: sha })).min(4),
+    settings: runSettingsSchema,
+    totalLimitMs: z.number().int().min(20000).max(1200000),
+    items: z
+      .array(
+        z.object({
+          item_id: z.string().min(1),
+          prompt: z.string().min(1).max(30000),
+        }),
+      )
+      .min(1)
+      .max(14),
+  })
+  .superRefine((c, ctx) => {
+    if (c.settings.warmups !== 0 || c.settings.thinking)
+      ctx.addIssue({
+        code: "custom",
+        message: "Task protocol requires zero warmups and thinking disabled",
+      });
+    if (
+      c.integrationGate &&
+      (c.items.length !== 1 || c.settings.maxTokens !== 256)
+    )
+      ctx.addIssue({
+        code: "custom",
+        message:
+          "Integration v2 permits exactly one item and 256 output tokens per arm",
+      });
+    if (new Set(c.items.map((x) => x.item_id)).size !== c.items.length)
+      ctx.addIssue({ code: "custom", message: "Task item IDs must be unique" });
+    if (new Set(c.assets.map((x) => x.url)).size !== c.assets.length)
+      ctx.addIssue({ code: "custom", message: "Asset URLs must be unique" });
+    for (const url of [
+      c.model.modelUrl,
+      c.model.modelLib,
+      ...c.assets.map((x) => x.url),
+    ]) {
+      const u = new URL(url);
+      if (
+        u.protocol !== "http:" ||
+        u.hostname !== "127.0.0.1" ||
+        u.username ||
+        u.password ||
+        u.hash
+      )
+        ctx.addIssue({
+          code: "custom",
+          message: "Only local loopback artifact URLs are allowed",
+        });
+    }
+    if (
+      !c.model.id.includes(c.convertedArtifactSha256.slice(0, 12)) ||
+      !c.model.modelUrl.includes(c.convertedArtifactSha256.slice(0, 12))
+    )
+      ctx.addIssue({
+        code: "custom",
+        message: "Model and cache URL must include converted artifact hash",
+      });
+    if (!c.model.modelUrl.endsWith(`/resolve/${c.convertedArtifactSha256}/`))
+      ctx.addIssue({
+        code: "custom",
+        message:
+          "WebLLM local model URL must end in /resolve/<artifact-sha256>/ to avoid implicit resolve/main rewriting",
+      });
+    if (c.settings.requestLimitMs + 15000 >= c.totalLimitMs)
+      ctx.addIssue({
+        code: "custom",
+        message:
+          "Session must reserve at least 15 seconds beyond response limit for cleanup",
+      });
+  });
+export type TaskEvaluation = z.infer<typeof taskEvaluationSchema>;
+export function taskGenerationOptions(task: TaskEvaluation) {
+  return {
+    ...generationOptions(task.settings, false, true),
+    presence_penalty: 0,
+    frequency_penalty: 0,
+    repetition_penalty: 1,
+    n: 1,
+    ignore_eos: false,
+  };
+}
+export function taskPlan(task: TaskEvaluation) {
+  return {
+    ...planFor("task-evaluation", "standard", task.settings),
+    measuredRequests: task.items.length,
+    totalLimitMs: task.totalLimitMs,
+    baselineMs: 2000,
+    idleMs: 0,
+    recoveryMs: 2000,
+    resetPolicy: `resetChat before each frozen development item; seed ${task.settings.seed}`,
+  };
+}
diff --git a/src/benchmark/task-evaluation/records.ts b/src/benchmark/task-evaluation/records.ts
new file mode 100644
index 0000000..30ff92e
--- /dev/null
+++ b/src/benchmark/task-evaluation/records.ts
@@ -0,0 +1,58 @@
+/** Preserve every attempted response, including a stream that throws or is cancelled. */
+export function taskSample(input: {
+  itemId: string;
+  output: string;
+  finish: string;
+  tokens: number | null;
+  inputTokens: number | null;
+  responseMs: number;
+  loadMs: number | null;
+  error: string | null;
+  stopReason: string | null;
+  stopStatus: string;
+  submittedBatches: number;
+}) {
+  const cancelled =
+    Boolean(input.stopReason) && input.stopStatus === "cancelled";
+  const interrupted =
+    Boolean(input.stopReason) && input.stopStatus === "interrupted";
+  const error =
+    input.error ??
+    input.stopReason ??
+    (!["stop", "length"].includes(input.finish)
+      ? `Unresolved finish reason: ${input.finish}`
+      : input.submittedBatches < 1
+        ? "No WebGPU submission observed during target request"
+        : null);
+  const finish = input.stopReason
+    ? cancelled
+      ? "cancelled"
+      : interrupted
+        ? "interrupted"
+        : input.stopReason.startsWith("Request exceeded ")
+          ? "timeout"
+          : "error"
+    : error
+      ? "error"
+      : input.finish;
+  return {
+    item_id: input.itemId,
+    raw_output: input.output,
+    finish_reason: finish,
+    generated_tokens: input.tokens,
+    input_tokens: input.inputTokens,
+    response_latency_ms: input.responseMs,
+    loading_time_ms: input.loadMs,
+    execution_error: error,
+    cancelled,
+    truncated: input.finish === "length",
+    valid_completion:
+      !error &&
+      input.finish === "stop" &&
+      input.output.trim().length > 0 &&
+      !input.output.includes("\uFFFD") &&
+      (input.tokens ?? 0) > 0,
+    webgpu_submitted_batches: input.submittedBatches,
+    local_webgpu_inference_observed: input.submittedBatches > 0,
+  };
+}
